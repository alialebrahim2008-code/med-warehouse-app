+}
+function renderReports(){
+  if(!reports.length){
+    $('reportList').innerHTML='<div class="ok">لا توجد تقارير محفوظة.</div>';
+    return;
+  }
+  $('reportList').innerHTML=reports.map(r=>`
+    <div class="card case">
+      <strong>${esc(r.titleAr||'تقرير')}</strong><br>
+      <span class="meta">${esc(r.titleEn||'')}<br>آخر تحديث: ${new Date(r.updatedAt||r.createdAt).toLocaleString('ar-SA')}</span>
+      <pre class="email ar">${esc(r.ar||'')}</pre>
+      <details><summary>النسخة الإنجليزية</summary><pre class="email">${esc(r.en||'')}</pre></details>
+      <details><summary>الترجمة العكسية العربية</summary><pre class="email ar">${esc(r.backAr||'')}</pre></details>
+      <button class="secondary" onclick="editReport('${r.id}')">تحرير التقرير</button>
+      <button class="secondary" onclick="copyReport('${r.id}','ar')">نسخ العربي</button>
+      <button class="secondary" onclick="copyReport('${r.id}','en')">نسخ الإنجليزي</button>
+    </div>
+  `).join('');
+}
+$('saveReportBtn').onclick=()=>{
+  const id=$('reportId').value||uid();
+  const titleAr=$('reportTitleAr').value.trim();
+  const titleEn=$('reportTitleEn').value.trim();
+  const ar=$('reportAr').value.trim();
+  const en=$('reportEn').value.trim();
+  const backAr=$('reportBackAr').value.trim();
+
+  if(!titleAr||!titleEn||!ar||!en||!backAr){
+    $('reportMessage').innerHTML='<div class="error">أكمل العنوانين والنص العربي والإنجليزي والترجمة العكسية.</div>';
+    return;
+  }
+  if(!$('reportReviewed').checked){
+    $('reportMessage').innerHTML='<div class="error">راجع النسخ الثلاث ثم فعّل الاعتماد قبل الحفظ.</div>';
+    return;
+  }
+
+  const now=new Date().toISOString();
+  const existing=reports.find(x=>x.id===id);
+  const rec={
+    id,titleAr,titleEn,ar,en,backAr,
+    translationFlow:'ARABIC_ORIGINAL_TO_ENGLISH_TO_ARABIC_BACK_TRANSLATION',
+    reviewed:true,
+    createdAt:existing?.createdAt||now,
+    updatedAt:now
+  };
+
+  if(existing)Object.assign(existing,rec);
+  else reports.unshift(rec);
+
+  save(KEYS.reports,reports);
+  $('reportId').value=id;
+  $('reportReviewed').checked=false;
+  $('reportMessage').innerHTML='<div class="ok">تم حفظ التقرير.</div>';
+  renderReports();
+};
+$('newReportBtn').onclick=clearReportForm;
+
+window.editReport=id=>{
+  const r=reports.find(x=>x.id===id);if(!r)return;
+  $('reportId').value=r.id;
+  $('reportTitleAr').value=r.titleAr||'';
+  $('reportTitleEn').value=r.titleEn||'';
+  $('reportAr').value=r.ar||'';
+  $('reportEn').value=r.en||'';
+  $('reportBackAr').value=r.backAr||'';
+  $('reportReviewed').checked=false;
+  show('reports');
+  window.scrollTo({top:0,behavior:'smooth'});
+};
+
+window.copyReport=async(id,lang)=>{
+  const r=reports.find(x=>x.id===id);if(!r)return;
+  const text=lang==='en'
+    ? `${r.titleEn}\n\n${r.en}`
+    : `${r.titleAr}\n\n${r.ar}`;
+  try{
+    await navigator.clipboard.writeText(text);
+    alert(lang==='en'?'تم نسخ التقرير الإنجليزي.':'تم نسخ التقرير العربي.');
+  }catch{
+    prompt('انسخ التقرير:',text);
+  }
+};
