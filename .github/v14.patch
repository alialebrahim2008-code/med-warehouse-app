+/* -------- Reports -------- */
+function clearReportForm(){
+  $('reportId').value='';
+  $('reportTitleAr').value='';
+  $('reportTitleEn').value='';
+  $('reportAr').value='';
+  $('reportEn').value='';
+  $('reportBackAr').value='';
